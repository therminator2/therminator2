[FreezeOut]
# ----------------------|-------------------------------|
#   FreezeOutModel      |  FreezeOutModelINI            |
# ----------------------|-------------------------------|
#   KrakowSFO           |  fomodel/krakow.ini           |
#   BlastWave           |  fomodel/blastwave.ini        |
#   BWAVT               |  fomodel/bwa.ini              |
#   BWAVTDelay          |  fomodel/bwa.ini              |
#   BWAVLinear          |  fomodel/bwa.ini              |
#   BWAVLinearDelay     |  fomodel/bwa.ini              |
#   BWAVLinearFormation |  fomodel/bwa.ini              |
#   Lhyquid3D           |  fomodel/lhyquid3d.ini        |
#   Lhyquid2DBI         |  fomodel/lhyquid2dbi.ini      |
#   SR                  |  fomodel/sr.ini               |
# ----------------------|-------------------------------|
# Name of the freeze-out model
# available: see table above
# default:	Lhyquid2DBI
FreezeOutModel = SR

# Custom freeze-out model ini file [not used by default]
# default:
# FreezeOutModelINI =

[Event]
# Number of events to generate 
# default:	50000
#NumberOfEvents = 10000
#NumberOfEvents = 1000

#NumberOfEvents = 500
NumberOfEvents = 100

#NumberOfEvents = 5

# Event output file format
# available:	root, root&text, text
# default:	root
EventFileType = unigen
#EventFileType = root

[Primordial]
# Distribution of primordial particles multiplicity
# available:	Poisson
# default:	Poisson
MultiplicityDistribution = Poisson

# Number of samples used in determination of
# primordial multiplicity and max. integrand value
# default:	   5000000
MaxIntegrateSamples = 5000000
#IntegrateSamples = 50000
# Tolerance of the primordial multiplicy, the integration 
# is interrupted early when the multiplicity does not change
# relatively by more then this value
# default = 0.00001
IntegTolerance = 0.0001
# Number of samples after which the relative change in multiplicity
# is tested
# default = 50
IntegToleranceInterval = 50
# Number of successive intervals (IntegToleranceInterval) in which 
# the multiplicity must change relativelty less than the Tolerance
# (IntegTolerance) in order for the multiplicity calculation to be
# interrupted early
# default: 10
IntegToleranceNSuccessive = 10

[Random]
# Start each event with a new random seed taken from current time (1)
# or do a constant seed (0)
# default:	1
Randomize = 0
Seed = SEED

[Directories]
# Directory with SHARE input files
# default:	share/
ShareDir = share/

# Directory with Freeze-Out Model parameter files
# default:	fomodels/
FreezeOutDir = fomodel/

# Directory with ROOT macro files *.C
# default:	macro/
MacroDir = macro/

# Directory to write the events
# default:	events/
EventDir = ./

[Logging]
# Log file
# default:	therminator.log
LogFile = therminator.log

# Coulomb afterburner flags
CoulombTimeSteps = 1000
# CoulombTimeSteps = 0
CoulombStepSize = 0.1

# Add the spectator nucleons of a Glauber MC event to the Coulomb
# propagation (1) or not (0)
# default:	1
CoulombUseSpectators = 1

# Extrapolate the trajectories of spectators (CoulombExtrapolateSpectators)
# and of primary fireball particles (CoulombExtrapolateFireball) back in
# time before their creation, when their field is needed there (1), or
# ignore them there (0)
# default:	1
CoulombExtrapolateSpectators = 1
# default:	1
CoulombExtrapolateFireball = 1

# Debugging of the Coulomb afterburner: printouts, and storing of large
# pair contributions for every step to trace back particles getting
# faster than light (1), or not (0)
# default:	1
CoulombFindProblem = 1

# With CoulombFindProblem, pair contributions with a Coulomb term larger
# than this (GeV/fm) are stored
# default:	1.0
CoulombLargeTerm = 1.0

# Time step, eid and eid of the other particle for detailed debugging
# printouts with CoulombFindProblem (-2: none)
# default:	-2
CoulombDebugStep = -2
# default:	-2
CoulombDebugEid = -2
# default:	-2
CoulombDebugOtherEid = -2

# Integrate the Coulomb force within close pairs of charged particles with
# sub-steps of the time step (1), or not (0). A pair is close when its
# encounter (passage at the closest distance, or change of the distance by
# the Coulomb force) is shorter than the time step divided by
# CoulombSubstepAccuracy. The time step alone cannot follow such encounters
# and gives too large momentum changes.
# default:	0
CoulombSubsteps = 0
# A sub-step is this fraction of the encounter time of a close pair
# default:	0.05
CoulombSubstepAccuracy = 0.05
# Maximum number of sub-steps in a time step
# default:	1024
CoulombSubstepMax = 1024
# Pairs further apart than this (fm) during the time step are not close
# default:	1.0
CoulombSubstepDistance = 1.0
